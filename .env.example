NODE_ENV=development
PORT=5000

# Oracle Database Credentials (bắt buộc cho legacy app)
ORACLE_DB_USER=report
ORACLE_DB_PASSWORD=your_oracle_password
ORACLE_CONNECT_VTEL=10.10.9.5:1521/report
ORACLE_CONNECT_VNP=10.15.9.5:1521/report
ORACLE_CONNECT_MBF=10.20.9.5:1521/report

# SSH Server Config (cho /run-script endpoint)
SSH_HOST=172.16.x.x
SSH_USER=root
SSH_PORT=22
SSH_PASSWORD=your_ssh_password

# Internal API Token - dùng xác thực /run-script
# Tạo token: openssl rand -hex 32
INTERNAL_API_TOKEN=your-strong-random-secret-min-32-chars

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI API Keys
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Telegram / OpenClaw
OPENCLAW_BOT_TOKEN=your-telegram-bot-token
OPENCLAW_AUTH_TOKEN=your-openclaw-auth-token
